# Copy to .env (it is gitignored) or export these variables.
# The backend reads them via the standard ASP.NET Core configuration.
MongoDBSettings__ConnectionString=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MongoDBSettings__DatabaseName=SkillupDB
Jwt__Key=replace-with-a-random-string-of-at-least-32-characters
Jwt__Issuer=SkillUpServer
Jwt__Audience=SkillUpClient
Jwt__DurationInMinutes=60

# Creates (or promotes) the administrator account on startup.
# The password is only used when the account is created.
Admin__Email=admin@example.com
Admin__Password=replace-with-a-strong-password
